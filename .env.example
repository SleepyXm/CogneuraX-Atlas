# The default TEI image targets Apple Silicon. x86_64 hosts use:
# TEI_IMAGE=ghcr.io/huggingface/text-embeddings-inference:cpu-1.9

ATLAS_SERVICE_TOKEN=replace-me
ATLAS_INDEX_VERSION=v2
ATLAS_DENSE_THRESHOLD=0.55
ATLAS_SPARSE_THRESHOLD=5.0
ATLAS_REGION_MAX_TOKENS=128

EMBED_MODEL=BAAI/bge-small-en-v1.5
TEI_EMBEDDING_DIMENSION=384

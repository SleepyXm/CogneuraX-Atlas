# The default TEI image targets x86_64 PCs. Apple Silicon uses:
# TEI_IMAGE=ghcr.io/huggingface/text-embeddings-inference:cpu-arm64-latest

ATLAS_SERVICE_TOKEN=replace-me
ATLAS_INDEX_VERSION=v1
ATLAS_DENSE_THRESHOLD=0.55
ATLAS_SPARSE_THRESHOLD=5.0

EMBED_MODEL=BAAI/bge-small-en-v1.5
TEI_EMBEDDING_DIMENSION=384
SUMMARY_MODEL=Qwen/Qwen3-4B-GGUF:Q6_K
SUMMARY_TOKENIZER=Qwen/Qwen3-4B
SUMMARY_CONTEXT=8192
SUMMARY_OUTPUT_TOKENS=700
